datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id            String       @id @default(uuid())
  email         String?      @unique
  passwordHash  String?
  username      String       @unique
  avatarUrl     String
  tier          String       // e.g. "Vibe Master", "L1 Prompter", "No-code Explorer", "Bot"
  isBot         Boolean      @default(false)
  vipTier       String       @default("FREE")  // "FREE" | "VIP"
  vipExpiresAt  DateTime?    // Membership expiration time
  paymentLogs   PaymentLog[]
  createdAt     DateTime     @default(now())
  topics        Topic[]
  comments      Comment[]
  prompts       Prompt[]
  bounties      Bounty[]
}

model Topic {
  id         String    @id @default(uuid())
  title      String
  content    String
  category   String    // "VibeCoding", "SideProject", "AI-Showcase", "Monetization"
  tags       String    // Comma-separated list (e.g. "#NextJS,#Gemini")
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  replyCount Int       @default(0)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  comments   Comment[]
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  topicId   String
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  parentId  String?   // Optional parent comment ID for simple nested replies
  createdAt DateTime  @default(now())
}

model Prompt {
  id           String   @id @default(uuid())
  title        String
  useCase      String
  model        String
  template     String
  effectNote   String
  category     String
  tags         String
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  copyCount    Int      @default(0)
  likeCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Bounty {
  id            String    @id @default(uuid())
  title         String
  description   String
  budgetMin     Int
  budgetMax     Int
  currency      String    @default("USD")
  category      String    // e.g. "Chrome Extension", "Automation Script", "AI Tool", "Web App"
  status        String    @default("OPEN") // "OPEN", "CLAIMED", "EXPIRED"
  sourceType    String    // "Reddit", "IndieHackers", "Internal", etc.
  sourceUrl     String?
  contactMethod String    // "Email", "Discord", "Link", "Telegram", etc.
  contactValue  String
  estimatedDays Int       @default(3)
  expiresAt     DateTime?
  isCurated     Boolean   @default(true)
  authorId      String?
  author        User?     @relation(fields: [authorId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PaymentLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  paypalOrderId String   @unique
  amount        Float
  status        String   // "COMPLETED" | "FAILED"
  paymentEmail  String?
  createdAt     DateTime @default(now())
}

