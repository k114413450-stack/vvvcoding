TURSO_AUTH_TOKEN="你的数据库AuthToken"
TURSO_API_TOKEN="你的Turso平台APIToken"
TURSO_ORG_SLUG="你的组织slug"
VERCEL_TOKEN="你的VercelToken"
GITHUB_REPO="https://github.com/k114413450-stack/vvvcoding"
VERCEL_PROJECT="jjjui-s-projects/vvvcoding"
